<Project>
  <!--
    Central package management: every NuGet version is defined once, here.
    Projects reference packages without a Version attribute.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Engine -->
    <PackageVersion Include="UnitsNet" Version="5.75.1" />
    <!-- Compiler polyfills (IsExternalInit, required members, CallerArgumentExpression) for netstandard2.1 -->
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
